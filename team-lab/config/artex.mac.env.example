# 설정 예시이며 현재 적용되지 않았습니다. 실제 .env는 아직 만들지 않습니다.
# 배포 후보 태그입니다. 설치 전에 이미지 digest와 소스/skills 버전을 맞춥니다.
ARTEX_TAG=v0.3.15-global.1
POSTGRES_USER=artex
POSTGRES_PASSWORD=
POSTGRES_DB=artex

# Mac 로컬 UI. 데이터베이스 포트는 원래 Compose에서 게시하지 않습니다.
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
ARTEX_CORS_ORIGINS=
ARTEX_LANG=ko

# OpenAI는 요청 형식 이름입니다. 호출 대상은 Mac의 로컬 Ollama입니다.
# ollama는 로컬 형식 확인용 문자열이며 실제 인증을 제공하지 않습니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=ollama
ARTEX_LLM_PROVIDER=openai
ARTEX_LLM_MODEL=artex-qwen3-8b-32k
ARTEX_LLM_BASE_URL=http://host.docker.internal:11434/v1
ARTEX_LLM_PROXY=

# 문맥/출력 상한/worker는 별도 프로파일·설정 화면에서 입력합니다.
# 이 파일의 위치를 바꾸지 않은 채 자동으로 Compose가 읽는다고 가정하지 않습니다.
