AIRPORT_BIND_IP=127.0.0.1
AIRPORT_WEB_PORT=8088
AIRPORT_DB_PASSWORD=replace-with-random-value
AIRPORT_DB_ROOT_PASSWORD=replace-with-another-random-value
AIRPORT_DEMO_PASSWORD=LabDemo!2026
AIRPORT_AUTO_SEED=1
AIRPORT_LAB_MODE=baseline
AIRPORT_CHATBOT_MODE=mock
AIRPORT_CHATBOT_MODEL=claude-haiku-5-5
