# Local inference (set AIRPORT_CHATBOT_MODE=ollama)
AIRPORT_OLLAMA_URL=http://host.docker.internal:11434
AIRPORT_OLLAMA_MODEL=gpt-oss:20b
AIRPORT_OLLAMA_TIMEOUT=90

# MFA is enabled only after out-of-band account enrollment.
AIRPORT_MFA_ENABLED=0
AIRPORT_MFA_SECRET_FILE=
